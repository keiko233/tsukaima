# Example Compose variables. bootstrap-host.sh writes the real file; secrets live separately in
# <deployment-root>/secrets/runtime.env. Never commit a populated copy.
TSUKAIMA_ROOT=/opt/tsukaima
TSUKAIMA_IMAGE=tsukaima:0.2.0
TSUKAIMA_VERSION=0.2.0
TSUKAIMA_COMMIT=
TSUKAIMA_PATCH_SHA256=
TSUKAIMA_DEPLOYER=deploy
TSUKAIMA_PUBLIC_URL=https://chat.example.com
TSUKAIMA_TRUSTED_ORIGINS=https://chat.example.com
TSUKAIMA_BIND_ADDR=127.0.0.1
TSUKAIMA_DOCKER_NETWORK=tsukaima
TSUKAIMA_TRUSTED_PROXIES=172.16.0.0/12
