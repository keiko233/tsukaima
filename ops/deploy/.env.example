# Compose variables. Written by deploy.sh; /opt/tsukaima/secrets/runtime.env holds secrets.
TSUKAIMA_ROOT=/opt/tsukaima
TSUKAIMA_IMAGE=tsukaima:0.1.0
TSUKAIMA_VERSION=0.1.0
TSUKAIMA_COMMIT=
TSUKAIMA_DEPLOYER=example-user
TSUKAIMA_PUBLIC_URL=http://app.example.test
TSUKAIMA_TRUSTED_ORIGINS=http://app.example.test
TSUKAIMA_BIND_ADDR=127.0.0.1
TSUKAIMA_TRUSTED_PROXIES=172.16.0.0/12
