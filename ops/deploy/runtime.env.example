# Copy to <deployment-root>/secrets/runtime.env with mode 0600. Never commit real values.
# Required: 32+ characters. Rotating it invalidates sessions but keeps the admin account.
TSUKAIMA_AUTH_SECRET=
# First-boot administrator. Existing auth users are kept when the data directory is migrated.
TSUKAIMA_ADMIN_USERNAME=
TSUKAIMA_ADMIN_PASSWORD=
TSUKAIMA_ADMIN_EMAIL=
# Optional plugin fallbacks. Prefer the plugin settings panel (stored in domain.sqlite).
TSUKAIMA_OPENAI_BASE_URL=
TSUKAIMA_OPENAI_API_KEY=
TSUKAIMA_ONEBOT_WS_URL=
TSUKAIMA_ONEBOT_ACCESS_TOKEN=
TSUKAIMA_LOG_LEVEL=info
