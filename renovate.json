{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"security:minimumReleaseAgeNpm",
		":maintainLockFilesWeekly",
		":semanticCommits"
	],
	"prConcurrentLimit": 5,
	"ignorePaths": ["packages/migration/fixtures/**"],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Track the GitHub CLI version pinned in the runtime image",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": ["ARG GH_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"depNameTemplate": "cli/cli",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
			"autoReplaceStringTemplate": "ARG GH_VERSION={{{newValue}}}"
		},
		{
			"customType": "regex",
			"description": "Keep the Bun runtime installed by the e2e workflow current",
			"managerFilePatterns": ["/^\\.github/workflows/test\\.yml$/"],
			"matchStrings": ["npm install --global bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"depNameTemplate": "bun",
			"datasourceTemplate": "npm"
		}
	],
	"packageRules": [
		{
			"groupName": "pi agent packages",
			"matchPackageNames": ["@earendil-works/**"]
		},
		{
			"groupName": "oRPC",
			"matchPackageNames": ["@orpc/**"]
		},
		{
			"groupName": "inlang",
			"matchPackageNames": ["@inlang/**"]
		},
		{
			"groupName": "better-auth",
			"matchPackageNames": ["better-auth", "@better-auth/**"]
		},
		{
			"groupName": "drizzle",
			"matchPackageNames": ["drizzle-orm", "drizzle-kit"]
		},
		{
			"groupName": "react",
			"matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"]
		},
		{
			"groupName": "oxc tooling",
			"matchPackageNames": ["oxfmt", "oxlint"]
		},
		{
			"groupName": "Bun toolchain",
			"matchPackageNames": ["bun", "@types/bun", "oven/bun"]
		},
		{
			"groupName": "Playwright",
			"matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"]
		}
	]
}
