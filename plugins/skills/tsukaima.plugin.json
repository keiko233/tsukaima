{
	"name": "skills",
	"version": "0.1.0",
	"apiVersion": "1",
	"kind": "builtin",
	"permissions": ["ui.panel", "tools", "audit.write"],
	"tools": [],
	"hooks": [],
	"ui": [],
	"configSchema": {
		"properties": {
			"paths": {
				"type": "array",
				"items": { "type": "string" }
			},
			"disabled": {
				"type": "array",
				"items": { "type": "string" }
			},
			"surfaces": {
				"type": "array",
				"items": { "type": "string", "enum": ["chat", "workspace"] }
			},
			"allowResources": { "type": "boolean" },
			"maxCatalogChars": { "type": "integer", "minimum": 500, "maximum": 8000 },
			"refreshIntervalSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 }
		},
		"type": "object"
	},
	"configEnv": { "paths": "TSUKAIMA_SKILLS_PATHS" },
	"secretKeys": []
}
