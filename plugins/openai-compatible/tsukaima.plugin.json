{
	"name": "openai-compatible",
	"version": "0.1.0",
	"apiVersion": "1",
	"kind": "builtin",
	"permissions": ["ui.panel", "model.call", "settings"],
	"configSchema": {
		"type": "object",
		"properties": {
			"baseUrl": {
				"type": "string"
			},
			"apiKey": {
				"type": "string"
			},
			"modelId": {
				"type": "string",
				"description": "Legacy single-model configuration; migrated when models are saved."
			},
			"models": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"id": {
							"type": "string"
						},
						"name": {
							"type": "string"
						},
						"enabled": {
							"type": "boolean"
						},
						"supportsTools": {
							"type": "boolean"
						},
						"supportsReasoning": {
							"type": "boolean"
						},
						"reasoningLevels": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"defaultReasoningLevel": {
							"type": "string"
						},
						"supportsImage": {
							"type": "boolean"
						},
						"supportsImageGeneration": {
							"type": "boolean"
						},
						"supportsAudio": {
							"type": "boolean"
						},
						"supportsSidechat": {
							"type": "boolean"
						},
						"capabilities": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"contextWindow": {
							"type": "integer"
						},
						"maxOutputTokens": {
							"type": "integer"
						}
					}
				}
			},
			"profiles": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"id": {
							"type": "string"
						},
						"name": {
							"type": "string"
						},
						"enabled": {
							"type": "boolean"
						},
						"baseUrl": {
							"type": "string"
						},
						"models": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"id": {
										"type": "string"
									},
									"name": {
										"type": "string"
									},
									"enabled": {
										"type": "boolean"
									},
									"supportsTools": {
										"type": "boolean"
									},
									"supportsReasoning": {
										"type": "boolean"
									},
									"reasoningLevels": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"defaultReasoningLevel": {
										"type": "string"
									},
									"supportsImage": {
										"type": "boolean"
									},
									"supportsImageGeneration": {
										"type": "boolean"
									},
									"supportsAudio": {
										"type": "boolean"
									},
									"supportsSidechat": {
										"type": "boolean"
									},
									"capabilities": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"contextWindow": {
										"type": "integer"
									},
									"maxOutputTokens": {
										"type": "integer"
									}
								}
							}
						}
					}
				}
			},
			"profileApiKeys": {
				"type": "object",
				"additionalProperties": {
					"type": "string"
				}
			}
		}
	},
	"configEnv": {
		"baseUrl": "TSUKAIMA_OPENAI_BASE_URL",
		"apiKey": "TSUKAIMA_OPENAI_API_KEY",
		"modelId": "TSUKAIMA_OPENAI_MODEL_ID"
	},
	"secretKeys": ["apiKey", "profileApiKeys"],
	"ui": []
}
