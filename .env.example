TSUKAIMA_HOST=127.0.0.1
TSUKAIMA_PORT=7420
TSUKAIMA_DATA_DIR=./data
TSUKAIMA_LOG_LEVEL=info
# Public origin used by Better Auth. Set the real HTTPS origin before deployment.
TSUKAIMA_PUBLIC_URL=http://127.0.0.1:7420
# At least 32 characters. Required when NODE_ENV=production.
TSUKAIMA_AUTH_SECRET=
# Development only: Vite serves the WebUI from this origin.
TSUKAIMA_WEB_ORIGIN=http://127.0.0.1:7421
# Defaults to true when TSUKAIMA_PUBLIC_URL starts with https://.
TSUKAIMA_AUTH_SECURE_COOKIES=false
# First-start administrator. Better Auth stores the credential and sessions in the domain
# database. Without an existing administrator and without these values, admin access stays locked.
TSUKAIMA_ADMIN_USERNAME=
TSUKAIMA_ADMIN_PASSWORD=
TSUKAIMA_ADMIN_EMAIL=
# OneBot values are the `onebot-napcat` plugin's environment fallbacks.
TSUKAIMA_ONEBOT_WS_URL=
TSUKAIMA_ONEBOT_ACCESS_TOKEN=
TSUKAIMA_OPENAI_BASE_URL=
TSUKAIMA_OPENAI_API_KEY=
TSUKAIMA_OPENAI_MODEL_ID=
