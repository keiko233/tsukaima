ELAINA_HOST=127.0.0.1
ELAINA_PORT=7420
ELAINA_DATA_DIR=./data
ELAINA_LOG_LEVEL=info
# First-start admin bootstrap (argon2id hash is stored in the domain database; without stored
# credentials the admin API and WebUI sign-in stay locked).
ELAINA_ADMIN_USERNAME=
ELAINA_ADMIN_PASSWORD=
# OneBot values are the `onebot-napcat` plugin's environment fallbacks.
ELAINA_ONEBOT_WS_URL=
ELAINA_ONEBOT_ACCESS_TOKEN=
ELAINA_OPENAI_BASE_URL=
ELAINA_OPENAI_API_KEY=
ELAINA_OPENAI_MODEL_ID=
