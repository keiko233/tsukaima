TSUKAIMA_HOST=127.0.0.1
TSUKAIMA_PORT=7420
TSUKAIMA_DATA_DIR=./data
# Built WebUI directory served by the server in production (default: apps/web/dist).
TSUKAIMA_WEB_DIST=
# Injected by the deployment image; source checkouts read VERSION instead.
TSUKAIMA_VERSION=
# Log level (trace, debug, info, warn, error). When set, overrides persisted runtime settings on startup.
TSUKAIMA_LOG_LEVEL=info
# In-memory diagnostic log ring buffer capacity (default: 5000).
TSUKAIMA_LOG_BUFFER_CAPACITY=5000
# Daily date-chunked file logs (<TSUKAIMA_LOG_DIR>/tsukaima-YYYY-MM-DD.log). Enabled by default.
TSUKAIMA_LOG_FILE_ENABLED=true
# Directory for daily file logs (default: <TSUKAIMA_DATA_DIR>/logs).
TSUKAIMA_LOG_DIR=
# Optional number of days to retain daily log files; unset keeps all files.
TSUKAIMA_LOG_RETENTION_DAYS=
# Public origin used by Better Auth. Set the real HTTPS origin before deployment.
TSUKAIMA_PUBLIC_URL=http://127.0.0.1:7420
# At least 32 characters. Required when NODE_ENV=production.
TSUKAIMA_AUTH_SECRET=
# Development only: Vite serves the WebUI from this origin.
TSUKAIMA_WEB_ORIGIN=http://127.0.0.1:7421
# Additional browser origins accepted by Better Auth, comma-separated.
TSUKAIMA_TRUSTED_ORIGINS=
# Reverse proxies whose forwarded client IP headers may be trusted, comma-separated.
TSUKAIMA_TRUSTED_PROXIES=
# Inbound channel media is fetched only from public hosts by default. List the channel sidecar
# host (for example `127.0.0.1` when NapCat runs on the same host) to allow private image URLs.
TSUKAIMA_MEDIA_FETCH_ALLOWED_HOSTS=
# Defaults to true when TSUKAIMA_PUBLIC_URL starts with https://.
TSUKAIMA_AUTH_SECURE_COOKIES=false
# First-start administrator. Better Auth stores the credential and sessions in the domain
# database. Without an existing administrator and without these values, admin access stays locked.
TSUKAIMA_ADMIN_USERNAME=
TSUKAIMA_ADMIN_PASSWORD=
TSUKAIMA_ADMIN_EMAIL=
# OneBot values are the `onebot-napcat` plugin's environment fallbacks.
TSUKAIMA_ONEBOT_WS_URL=
TSUKAIMA_ONEBOT_ACCESS_TOKEN=
TSUKAIMA_OPENAI_BASE_URL=
TSUKAIMA_OPENAI_API_KEY=
# Legacy single-model fallback. New installs should configure models in the plugin panel.
TSUKAIMA_OPENAI_MODEL_ID=
# Telegram sticker import (sticker-meme plugin). Create a bot with @BotFather.
TSUKAIMA_TELEGRAM_BOT_TOKEN=
# Optional Bot API server override, for local/proxy deployments only.
TSUKAIMA_TELEGRAM_API_BASE_URL=
# Optional ffmpeg path for Telegram video-sticker to GIF conversion; PATH is used by default.
TSUKAIMA_FFMPEG_PATH=
# Optional OpenAI-compatible vision model for sticker semantic preprocessing.
# Without these the plugin uses its deterministic emoji/title classifier.
TSUKAIMA_SEMANTIC_BASE_URL=
TSUKAIMA_SEMANTIC_API_KEY=
TSUKAIMA_SEMANTIC_MODEL=
# Optional scheduled SQLite + blob backup/restore drill. Unset or 0 keeps it disabled.
TSUKAIMA_BACKUP_DRILL_INTERVAL_MS=
# Parent directory for scheduled drill backups/reports (default: <data>/backup-drills).
TSUKAIMA_BACKUP_DRILL_ROOT=
# Git remote compared and merged by Settings -> Upgrades. Defaults to origin.
TSUKAIMA_UPGRADE_REMOTE=origin
# Checkout the repository surfaces read and write (default: the process working directory).
TSUKAIMA_REPOSITORY_ROOT=
# Allow Settings -> Upgrades to push the current branch. Off unless explicitly set to true.
TSUKAIMA_ALLOW_PUSH=false
# GitHub REST base URL. Override for GitHub Enterprise Server (https://<host>/api/v3).
TSUKAIMA_GITHUB_API_URL=https://api.github.com
