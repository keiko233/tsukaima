{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["bun", "vite/client"],
		"noEmit": true,
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@elaina/ui/*": ["../../packages/ui/src/*"],
			"@elaina/ui": ["../../packages/ui/src/index.ts"],
			"@elaina/sdk/*": ["../../packages/sdk/src/*"],
			"@elaina/sdk": ["../../packages/sdk/src/index.ts"],
			"@elaina/contracts": ["../../packages/contracts/src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"exclude": ["node_modules", "dist", "src/components/previews"]
}
