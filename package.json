{
	"name": "elaina-chatbot",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '@elaina/server' dev",
		"build": "bun run --filter '*' build",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt 'apps/**/*.ts' 'packages/**/*.ts' '*.json' '*.ts' '.env.example'",
		"format:check": "oxfmt --check 'apps/**/*.ts' 'packages/**/*.ts' '*.json' '*.ts' '.env.example'",
		"test": "bun test",
		"check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"typescript": "5.9.3"
	}
}
