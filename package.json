{
	"name": "tsukaima",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"plugins/*",
		"tools/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '@tsukaima/server' dev",
		"build": "bun run --filter '*' build",
		"typecheck": "tsc --noEmit && bun run --filter '@tsukaima/ui' typecheck && bun run --filter '@tsukaima/sdk' typecheck && bun run --filter '@tsukaima/web' typecheck",
		"lint": "oxlint .",
		"format": "oxfmt 'apps/**/*.ts' 'packages/**/*.ts' 'plugins/**/*.ts' 'plugins/**/*.json' 'tools/**/*.ts' 'tools/**/*.json' 'e2e/**/*.ts' 'playwright.config.ts' '*.json' '*.ts' '.env.example'",
		"format:check": "oxfmt --check 'apps/**/*.ts' 'packages/**/*.ts' 'plugins/**/*.ts' 'plugins/**/*.json' 'tools/**/*.ts' 'tools/**/*.json' 'e2e/**/*.ts' 'playwright.config.ts' '*.json' '*.ts' '.env.example'",
		"test": "bun test",
		"check": "bun run check:version && bun run lint && bun run format:check && bun run typecheck && bun run test",
		"check:secrets": "bun tools/ops/secret-scan.ts",
		"version:bump": "bun tools/ops/version.ts bump",
		"ops:backup-drill": "bun tools/ops/backup-drill.ts",
		"test:e2e": "playwright test",
		"check:version": "bun tools/ops/version.ts check",
		"ops:version": "bun tools/ops/version.ts show",
		"ops:deploy": "bash ops/deploy/deploy-local.sh",
		"pretest": "git restore --source=HEAD -- packages/migration/fixtures 2>/dev/null || true"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@types/bun": "1.4.5",
		"oxfmt": "0.80.0",
		"oxlint": "1.95.0",
		"typescript": "7.0.2"
	}
}
