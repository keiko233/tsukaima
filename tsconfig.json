{
	"compilerOptions": {
		"target": "ES2023",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"lib": ["ES2023"],
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@tsukaima/contracts": ["./packages/contracts/src/index.ts"],
			"@tsukaima/core": ["./packages/core/src/index.ts"],
			"@tsukaima/db": ["./packages/db/src/index.ts"],
			"@tsukaima/durable": ["./packages/durable/src/index.ts"]
		}
	},
	"include": ["apps/**/*.ts", "packages/**/*.ts", "tools/**/*.ts"],
	"exclude": ["node_modules", "dist", ".turbo", "coverage", "apps/web"]
}
